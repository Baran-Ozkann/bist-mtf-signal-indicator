// This source code is subject to the terms of the Mozilla Public License 2.0 at https://mozilla.org/MPL/2.0/
// BIST Multi-Timeframe Buy/Sell Signal System
// Conceptually inspired by SCALPTOOL R1.1 (JustUncleL) but written from scratch.
// No ticker-specific hardcoding: every calculation derives from bar data or user inputs.
//
// ============================================================================
//  BUILD STATUS
// ============================================================================
//  [x] Stage 1  Core layers 1-4 + simple total score
//  [x] Stage 2  MTF architecture (1D lock + hard veto)        <-- CURRENT
//  [ ] Stage 3  1h entry timing + 15m exhaustion gate
//  [ ] Stage 4  Mid-tier layers 6-8
//  [ ] Stage 5  Advanced layers 9-13
//  [ ] Stage 6  Cooldown + earnings blacklist
//  [ ] Stage 7  Visuals (plotshape, colour coding, score label)
//  [ ] Stage 8  Performance log panel
//  [ ] Stage 9  Unified alertcondition()
//  [ ] Stage 10 End-to-end / repaint testing
//
// ============================================================================
//  request.security() CALL INVENTORY  (Stage 2)
// ============================================================================
//  COUNT: 1  (budget target for the finished script: 4-5)
//
//  #1  Directional bias lock          [Stage 2]
//      symbol    : syminfo.tickerid          (never hardcoded)
//      timeframe : biasTF input, default "1D"
//      expression: f_dailyBiasExpr(off) -> [bias, adx, smaSide, emaSide]
//      lookahead : barmerge.lookahead_off    (mandatory, no future data)
//      gaps      : barmerge.gaps_off         (hold last known bias between
//                  daily closes; gaps_on would blank the bias on every
//                  intermediate chart bar and drop the veto to neutral)
//      CONSOLIDATION: the ADX / SMA / triple-EMA regime test is evaluated
//      INSIDE the daily context and only the finished verdict plus three
//      diagnostics come back, so all six daily series cost one call, not six.
//
//  Chart-timeframe work needs no security call: Heikin Ashi is derived
//  arithmetically from the chart's own real OHLC (see the HA block below)
//  rather than via request.security(ticker.heikinashi(...)). That saves a
//  call, is inherently repaint-safe, and keeps real OHLC available on the
//  same bar for layers 9 & 11 later.
//
//  Recommended chart timeframe: 4h (the spec's primary signal timeframe).
//  Nothing breaks on another TF; the bias reference is timeframe-agnostic.
//
// ============================================================================
//  REPAINT NOTE ON THE 1D REFERENCE
// ============================================================================
//  lookahead_off alone is NOT sufficient for realtime/historical parity. With
//  lookahead_off the historical bars of a forming daily bar show the LAST
//  CLOSED daily value, but the realtime bar shows the DEVELOPING daily value,
//  which mutates tick by tick. Those two behaviours disagree, which is exactly
//  the discrepancy bar-replay testing exposes.
//
//  Fix: biasConfirmedOnly (default ON) offsets the expression by one bar
//  INSIDE the daily context, so the value returned is always a fully closed
//  daily bar and is therefore identical historically and in realtime.
//  The offset must be applied inside the request (expr[1]); applying [1] to
//  the result outside would step back one CHART bar, not one DAILY bar.
//  Cost: the bias reflects the daily bar before last, i.e. up to one extra
//  day of lag. Turning the input OFF removes that lag and reintroduces
//  intrabar repainting of the developing daily bar - debugging only.
//
// ============================================================================
//  MIXED-CANDLE POLICY (enforced from Stage 1 onward)
// ============================================================================
//  Heikin Ashi (optional, default ON) : PAC channel, regime EMA ordering
//  Real OHLC (always)                 : ADX, SMA50, RSI, MACD, volume
//  Real OHLC (later, mandatory)       : layer 9 liquidity sweep, layer 11 candles
// ============================================================================

//@version=6
indicator("BIST MTF Signal System", shorttitle = "BIST MTF", overlay = false, precision = 1, max_bars_back = 1000)
// max_bars_back = 1000 covers the deepest Stage 1 lookback (slow EMA, default
// 200, user-raisable toward the 600 discussed in the spec) plus PAC/pivot
// warm-up headroom added in later stages.

// ============================================================================
//  INPUT GROUPS
// ============================================================================
const string G_GEN  = "General"
const string G_SRC  = "Candle Source (Heikin Ashi / PAC)"
const string G_L1   = "Layer 1 - Regime / Trend Filter"
const string G_L2   = "Layer 2 - PAC Crossover"
const string G_L3   = "Layer 3 - Momentum (RSI + MACD)"
const string G_L4   = "Layer 4 - Volume Confirmation"
const string G_L5   = "Layer 5 - 1D Directional Lock (hard veto)"
const string G_ENT  = "Entry Timing (1h)"
const string G_EXH  = "Exhaustion Gate (15m)"
const string G_DISP = "Display"

// ---------------------------------------------------------------- General ---
scoreThreshold = input.int(70, "Signal score threshold", minval = 1, maxval = 100, group = G_GEN,
     tooltip = "Reference line only in Stage 1. Becomes the live signal trigger in Stage 9.")
normalizeWeights = input.bool(true, "Renormalise score across ENABLED layers only", group = G_GEN,
     tooltip = "WEIGHT REDISTRIBUTION: total design weight is 100 across all 13 layers. " +
     "Stage 1 only ships layers 1-4 (55 of 100). With this ON the score is divided by the sum of " +
     "enabled weights, so it always spans 0-100. With it OFF the raw weighted sum is shown, so " +
     "disabling a layer removes its contribution WITHOUT redistributing it (max drops below 100).")

// ----------------------------------------------------------- Candle source ---
useHA = input.bool(true, "Use Heikin Ashi for PAC / EMA layers", group = G_SRC,
     tooltip = "Affects ONLY the PAC channel and the regime EMA ordering. ADX, SMA50, RSI, MACD " +
     "and volume always use real OHLC. Layers 9 and 11 will always use real OHLC.")
pacLen = input.int(34, "PAC length (EMA of HA high/low/close)", minval = 1, group = G_SRC)

// ---------------------------------------------------------------- Layer 1 ---
useL1     = input.bool(true, "Enable Layer 1", group = G_L1)
wL1       = input.float(20.0, "Weight", minval = 0.0, maxval = 100.0, step = 0.5, group = G_L1)
adxLen    = input.int(14, "ADX / DI length", minval = 1, group = G_L1)
adxSmooth = input.int(14, "ADX smoothing", minval = 1, group = G_L1)
adxThr    = input.float(25.0, "ADX trend threshold", minval = 0.0, step = 0.5, group = G_L1)
smaLen    = input.int(50, "SMA length (price vs SMA)", minval = 1, group = G_L1)
emaFastLen = input.int(34,  "EMA fast",   minval = 1, group = G_L1)
emaMedLen  = input.int(89,  "EMA medium", minval = 1, group = G_L1)
emaSlowLen = input.int(200, "EMA slow",   minval = 1, group = G_L1)

// ---------------------------------------------------------------- Layer 2 ---
useL2 = input.bool(true, "Enable Layer 2", group = G_L2)
wL2   = input.float(10.0, "Weight", minval = 0.0, maxval = 100.0, step = 0.5, group = G_L2)
pacDipBars = input.int(10, "PAC-mid pullback lookback (N bars)", minval = 1, maxval = 200, group = G_L2,
     tooltip = "Long: price must have closed BELOW PAC-mid within the last N bars. Short: mirrored.")

// ---------------------------------------------------------------- Layer 3 ---
useL3 = input.bool(true, "Enable Layer 3", group = G_L3)
wL3   = input.float(15.0, "Weight", minval = 0.0, maxval = 100.0, step = 0.5, group = G_L3)
rsiLen       = input.int(14, "RSI length",             minval = 1, group = G_L3)
rsiSmoothLen = input.int(9,  "RSI smoothing (SMA)",    minval = 1, group = G_L3)
macdFastLen  = input.int(12, "MACD fast",              minval = 1, group = G_L3)
macdSlowLen  = input.int(26, "MACD slow",              minval = 1, group = G_L3)
macdSigLen   = input.int(9,  "MACD signal",            minval = 1, group = G_L3)

// ---------------------------------------------------------------- Layer 4 ---
useL4 = input.bool(true, "Enable Layer 4", group = G_L4)
wL4   = input.float(10.0, "Weight", minval = 0.0, maxval = 100.0, step = 0.5, group = G_L4)
volLen     = input.int(20, "Volume SMA length", minval = 1, group = G_L4)
volRatioLo = input.float(0.5, "Low anchor: vol / avg",  minval = 0.0, step = 0.1, group = G_L4)
volConfLo  = input.float(0.2, "Low anchor: confidence", minval = 0.0, maxval = 1.0, step = 0.05, group = G_L4)
volRatioHi = input.float(2.0, "High anchor: vol / avg", minval = 0.1, step = 0.1, group = G_L4)
volConfHi  = input.float(1.0, "High anchor: confidence", minval = 0.0, maxval = 1.0, step = 0.05, group = G_L4)

// ------------------------------------- Layer 5 (hard veto, NOT weighted) ---
useVeto = input.bool(true, "Enable 1D hard veto", group = G_L5,
     tooltip = "Layer 5 carries no weight. It is a gate: if the 4h candidate direction disagrees " +
     "with the locked 1D bias - or the 1D bias is neutral - the ENTIRE score is zeroed before " +
     "display. Turn OFF to inspect the raw pre-veto score while tuning layers 1-4.")
biasTF = input.timeframe("1D", "Bias timeframe", group = G_L5)
biasConfirmedOnly = input.bool(true, "Use last CLOSED bias bar only (no repaint)", group = G_L5,
     tooltip = "ON  = repaint-safe. The bias is read one bar back inside the bias timeframe, so " +
     "realtime and historical values are identical under bar replay. Costs up to one extra day of lag.\n" +
     "OFF = uses the developing daily bar. Less lag, but the value mutates intrabar and historical " +
     "bars will NOT match what you saw live. Debugging only.")
dAdxLen     = input.int(14, "1D ADX / DI length", minval = 1, group = G_L5)
dAdxSmooth  = input.int(14, "1D ADX smoothing",   minval = 1, group = G_L5)
dAdxThr     = input.float(25.0, "1D ADX threshold", minval = 0.0, step = 0.5, group = G_L5)
dSmaLen     = input.int(50,  "1D SMA length",  minval = 1, group = G_L5)
dEmaFastLen = input.int(21,  "1D EMA fast",    minval = 1, group = G_L5)
dEmaMedLen  = input.int(50,  "1D EMA medium",  minval = 1, group = G_L5)
dEmaSlowLen = input.int(200, "1D EMA slow",    minval = 1, group = G_L5)

// ------------------------------------------------- Entry timing (1h) ---
useEntryTiming = input.bool(true, "Enable 1h entry timing", group = G_ENT,
     tooltip = "Once the signal-timeframe score crosses the threshold, the entry timeframe must " +
     "show a PAC touch AND a directional candle before the setup is called 'entry ready'. " +
     "Turn OFF to treat any threshold cross as entry ready.")
entryTF = input.timeframe("60", "Entry timing timeframe", group = G_ENT)
entryPacLen = input.int(34, "Entry PAC length", minval = 1, group = G_ENT)
entryMinBody = input.float(0.30, "Min candle body / range ratio", minval = 0.0, maxval = 1.0,
     step = 0.05, group = G_ENT,
     tooltip = "Rejects doji-like confirmation candles. Body must be at least this fraction of the " +
     "bar's full range. Uses REAL OHLC, never Heikin Ashi.")
entryConfirmedOnly = input.bool(true, "Entry TF: use last CLOSED bar only", group = G_ENT,
     tooltip = "Offsets the read one bar inside the entry timeframe. See the ENTRY GATE TIMING note " +
     "in the header for why this does not fully remove intrabar movement when the entry timeframe " +
     "is LOWER than the chart timeframe.")

// ---------------------------------------------- Exhaustion gate (15m) ---
useExhaustGate = input.bool(true, "Enable 15m exhaustion gate", group = G_EXH,
     tooltip = "Blocks the entry signal until the counter-move exhausts. Opens when ANY ONE of the " +
     "three conditions below is met. Turn OFF to let entry-ready setups signal immediately.")
exhaustTF = input.timeframe("15", "Exhaustion timeframe", group = G_EXH)
exhRsiLen = input.int(14, "Exhaustion RSI length", minval = 1, group = G_EXH)
exhRsiFlat = input.float(1.0, "RSI flat threshold (points)", minval = 0.0, step = 0.1, group = G_EXH,
     tooltip = "Condition 1: RSI is considered 'no longer progressing' when its bar-over-bar change " +
     "is within this many points while the prior change ran against the signal direction.")
exhSwingLb = input.int(5, "Swing lookback (bars)", minval = 2, maxval = 50, group = G_EXH,
     tooltip = "Condition 3: window used to define a 'new' extreme.")
exhSwingBars = input.int(3, "Bars without a new extreme", minval = 1, maxval = 50, group = G_EXH,
     tooltip = "Condition 3 opens when this many bars have passed without a new lower-low (long) " +
     "or higher-high (short) inside the swing lookback window.")
pinMaxBody = input.float(0.35, "Pin bar: max body / range", minval = 0.01, maxval = 1.0,
     step = 0.05, group = G_EXH)
pinMinWick = input.float(2.0, "Pin bar: min wick / body", minval = 0.5, step = 0.1, group = G_EXH)
exhaustConfirmedOnly = input.bool(true, "Exhaustion TF: use last CLOSED bar only", group = G_EXH)

// ---------------------------------------------------------------- Display ---
showComponents = input.bool(false, "Plot long / short component scores", group = G_DISP)
showRawScore   = input.bool(false, "Plot raw pre-veto score", group = G_DISP)
showBias       = input.bool(false, "Plot 1D bias (0 short / 50 neutral / 100 long)", group = G_DISP)

// ============================================================================
//  HELPERS
// ============================================================================

// Clamp v into [lo, hi]. na in -> na out (callers guard before calling).
f_clamp(float v, float lo, float hi) =>
    math.max(lo, math.min(hi, v))

// ----------------------------------------------------- Candle primitives ---
// These take explicit OHLC arguments rather than reading the globals, so the
// caller decides which candle type is fed in. Per MIXED-CANDLE POLICY every
// caller of these MUST pass REAL OHLC - pattern recognition on Heikin Ashi
// bars is meaningless (HA opens are synthetic midpoints, so nearly every HA
// bar looks like an engulfing). Shared by the 1h confirmation, the 15m
// exhaustion gate, and layer 11 in Stage 5.

// Body size as a fraction of the bar's full range. Zero-range bar -> 0.0.
f_bodyRatio(float o, float h, float l, float c) =>
    float rng = h - l
    na(o) or na(h) or na(l) or na(c) or rng <= 0.0 ? 0.0 : math.abs(c - o) / rng

// Pin bar / hammer. dir > 0 wants a long LOWER wick (lower prices rejected),
// dir < 0 a long UPPER wick. Requires a small body and the rejection wick to
// dominate the opposite wick.
f_isPinBar(int dir, float o, float h, float l, float c, float maxBody, float minWick) =>
    bool res = false
    float rng = h - l
    if na(o) or na(h) or na(l) or na(c) or rng <= 0.0
        res := false
    else
        float body = math.abs(c - o)
        float upWick = h - math.max(o, c)
        float dnWick = math.min(o, c) - l
        bool smallBody = body / rng <= maxBody
        // Floor the divisor at 1% of range so a doji (body ~ 0) cannot make
        // the wick/body ratio explode to infinity or divide by zero.
        float bodySafe = math.max(body, rng * 0.01)
        res := dir > 0 ? (smallBody and dnWick >= minWick * bodySafe and dnWick > upWick)
             :           (smallBody and upWick >= minWick * bodySafe and upWick > dnWick)
    res

// Engulfing: current real body fully covers the previous real body and the
// two bars are opposite colours.
f_isEngulfing(int dir, float o, float c, float po, float pc) =>
    bool res = false
    if na(o) or na(c) or na(po) or na(pc)
        res := false
    else if dir > 0
        res := c > o and pc < po and c >= po and o <= pc
    else
        res := c < o and pc > po and c <= po and o >= pc
    res

// ============================================================================
//  HEIKIN ASHI (computed from this chart's real OHLC - no security call)
// ============================================================================
haClose = (open + high + low + close) / 4.0
var float haOpen = na
haOpen := na(haOpen[1]) ? (open + close) / 2.0 : (haOpen[1] + haClose[1]) / 2.0
haHigh = math.max(high, math.max(haOpen, haClose))
haLow  = math.min(low,  math.min(haOpen, haClose))

// Source selector for PAC / EMA layers only.
srcOpen  = useHA ? haOpen  : open
srcClose = useHA ? haClose : close
srcHigh  = useHA ? haHigh  : high
srcLow   = useHA ? haLow   : low

// ============================================================================
//  SHARED INDICATOR SERIES
//  Computed once at global scope and passed into the scoring functions as
//  parameters. This keeps every f_*Score() a PURE function (no ta.* calls in
//  conditional branches, no hidden state), so each layer can be called twice
//  - once for the long hypothesis, once for the short - and unit-tested in
//  isolation by feeding it fixed values.
// ============================================================================
[diPlus, diMinus, adxVal] = ta.dmi(adxLen, adxSmooth)   // real OHLC
smaVal  = ta.sma(close, smaLen)                          // real OHLC
emaFast = ta.ema(srcClose, emaFastLen)                   // HA-aware
emaMed  = ta.ema(srcClose, emaMedLen)                    // HA-aware
emaSlow = ta.ema(srcClose, emaSlowLen)                   // HA-aware

pacUpper = ta.ema(srcHigh,  pacLen)                      // HA-aware
pacLower = ta.ema(srcLow,   pacLen)                      // HA-aware
pacMid   = ta.ema(srcClose, pacLen)                      // HA-aware

rsiVal   = ta.rsi(close, rsiLen)                         // real OHLC
rsiMaVal = ta.sma(rsiVal, rsiSmoothLen)
[macdLine, macdSigLine, macdHist] = ta.macd(close, macdFastLen, macdSlowLen, macdSigLen)

volAvg = ta.sma(volume, volLen)                          // real volume

// ============================================================================
//  LAYER 1 - REGIME / TREND FILTER            (design weight 20)
//  confidence = (# of met sub-conditions) / 3
//    a) ADX(len) > threshold                   (non-directional)
//    b) close vs SMA(50)                       (directional, real OHLC)
//    c) EMA ordering fast > med > slow         (directional, HA-aware)
//  NA GUARD: during warm-up on a newly listed / short-history ticker any of
//  smaVal / emaSlow is na -> return neutral 0.5 rather than na or 0.
// ============================================================================
f_regimeScore(int dir, float adxv, float adxThreshold, float px, float sma, float eFast, float eMed, float eSlow) =>
    float res = 0.5
    if na(adxv) or na(px) or na(sma) or na(eFast) or na(eMed) or na(eSlow)
        res := 0.5
    else
        bool cAdx = adxv > adxThreshold
        bool cSma = dir > 0 ? px > sma : px < sma
        bool cEma = dir > 0 ? (eFast > eMed and eMed > eSlow) : (eFast < eMed and eMed < eSlow)
        res := ((cAdx ? 1.0 : 0.0) + (cSma ? 1.0 : 0.0) + (cEma ? 1.0 : 0.0)) / 3.0
    res

// ============================================================================
//  LAYER 2 - PAC CROSSOVER                     (design weight 10)
//  LONG : HA_open < PAC_upper AND HA_close > PAC_upper   -> fresh breakout 0.70
//         already trading above PAC_upper (no fresh cross) -> 0.35
//         PLUS closed below PAC_mid within last N bars     -> +0.30
//  SHORT: mirrored on PAC_lower / above PAC_mid.
//  Result clamped to [0, 1].
//  ta.barssince() is evaluated UNCONDITIONALLY at the top of the function for
//  both directions so no ta.* call ever sits inside an if-branch.
// ============================================================================
f_pacScore(int dir, float o, float c, float pUp, float pLo, float pMid, int dipBars) =>
    int barsSinceBelowMid = ta.barssince(c < pMid)
    int barsSinceAboveMid = ta.barssince(c > pMid)
    float res = 0.5
    if na(pUp) or na(pLo) or na(pMid) or na(o) or na(c)
        res := 0.5
    else
        float sc = 0.0
        if dir > 0
            bool fresh = o < pUp and c > pUp
            sc := fresh ? 0.7 : (c > pUp ? 0.35 : 0.0)
            bool pulled = not na(barsSinceBelowMid) and barsSinceBelowMid <= dipBars
            sc := sc + (pulled ? 0.3 : 0.0)
        else
            bool fresh = o > pLo and c < pLo
            sc := fresh ? 0.7 : (c < pLo ? 0.35 : 0.0)
            bool pulled = not na(barsSinceAboveMid) and barsSinceAboveMid <= dipBars
            sc := sc + (pulled ? 0.3 : 0.0)
        res := f_clamp(sc, 0.0, 1.0)
    res

// ============================================================================
//  LAYER 3 - MOMENTUM (RSI cross + MACD histogram)   (design weight 15)
//  0.5 sub-weight: RSI vs its smoothing line
//        fresh cross in signal direction -> 0.50 ; merely on the right side -> 0.25
//  0.5 sub-weight: MACD histogram direction CHANGE
//        turning bar (slope flips into signal direction) -> 0.50 ; still
//        moving in the right direction -> 0.25
//  NA GUARD: needs hist[2]; during warm-up -> neutral 0.5.
// ============================================================================
f_momentumScore(int dir, float rsi, float rsiMa, float hist) =>
    float res = 0.5
    if na(rsi) or na(rsiMa) or na(rsi[1]) or na(rsiMa[1]) or na(hist) or na(hist[1]) or na(hist[2])
        res := 0.5
    else
        bool rsiCrossUp   = rsi > rsiMa and rsi[1] <= rsiMa[1]
        bool rsiCrossDown = rsi < rsiMa and rsi[1] >= rsiMa[1]
        bool histTurnUp   = hist > hist[1] and hist[1] <= hist[2]
        bool histTurnDown = hist < hist[1] and hist[1] >= hist[2]
        float rsiPart  = 0.0
        float macdPart = 0.0
        if dir > 0
            rsiPart  := rsiCrossUp   ? 0.5 : (rsi > rsiMa    ? 0.25 : 0.0)
            macdPart := histTurnUp   ? 0.5 : (hist > hist[1] ? 0.25 : 0.0)
        else
            rsiPart  := rsiCrossDown ? 0.5 : (rsi < rsiMa    ? 0.25 : 0.0)
            macdPart := histTurnDown ? 0.5 : (hist < hist[1] ? 0.25 : 0.0)
        res := f_clamp(rsiPart + macdPart, 0.0, 1.0)
    res

// ============================================================================
//  LAYER 4 - VOLUME CONFIRMATION               (design weight 10)
//  ratio = volume / SMA(volume, 20), mapped linearly through two anchors
//  (default 0.5x -> 0.20 and 2.0x -> 1.00), clamped to [0, 1].
//  Non-directional: identical confidence for the long and short hypothesis.
//  DIV-BY-ZERO GUARD: volAvg na or <= 0 (illiquid / no-trade bar, or a feed
//  that reports zero volume) -> neutral 0.5.
//  Also guards against the user setting hi anchor == lo anchor.
// ============================================================================
f_volumeScore(float vol, float avg, float rLo, float cLo, float rHi, float cHi) =>
    float res = 0.5
    if na(vol) or na(avg) or avg <= 0.0 or math.abs(rHi - rLo) < 1e-10
        res := 0.5
    else
        float ratio = vol / avg
        float slope = (cHi - cLo) / (rHi - rLo)
        res := f_clamp(cLo + (ratio - rLo) * slope, 0.0, 1.0)
    res

// ============================================================================
//  SCORE AGGREGATION
//  Both hypotheses are scored every bar; the stronger one becomes the
//  candidate direction. Layers 1-4 are computed unconditionally (keeps ta.*
//  out of conditionals); the enable toggles act at aggregation time.
// ============================================================================
s1Long  = f_regimeScore( 1, adxVal, adxThr, close, smaVal, emaFast, emaMed, emaSlow)
s1Short = f_regimeScore(-1, adxVal, adxThr, close, smaVal, emaFast, emaMed, emaSlow)

s2Long  = f_pacScore( 1, srcOpen, srcClose, pacUpper, pacLower, pacMid, pacDipBars)
s2Short = f_pacScore(-1, srcOpen, srcClose, pacUpper, pacLower, pacMid, pacDipBars)

s3Long  = f_momentumScore( 1, rsiVal, rsiMaVal, macdHist)
s3Short = f_momentumScore(-1, rsiVal, rsiMaVal, macdHist)

s4Both  = f_volumeScore(volume, volAvg, volRatioLo, volConfLo, volRatioHi, volConfHi)

f_aggregate(float c1, float c2, float c3, float c4) =>
    float num = 0.0
    float den = 0.0
    if useL1
        num += c1 * wL1
        den += wL1
    if useL2
        num += c2 * wL2
        den += wL2
    if useL3
        num += c3 * wL3
        den += wL3
    if useL4
        num += c4 * wL4
        den += wL4
    float outv = 0.0
    if normalizeWeights
        outv := den > 0.0 ? num / den * 100.0 : 0.0
    else
        outv := num
    f_clamp(outv, 0.0, 100.0)

longScore  = f_aggregate(s1Long,  s2Long,  s3Long,  s4Both)
shortScore = f_aggregate(s1Short, s2Short, s3Short, s4Both)

// Candidate direction: +1 long, -1 short, 0 tie/flat.
sigDir  = longScore > shortScore ? 1 : (shortScore > longScore ? -1 : 0)
rawScore = math.max(longScore, shortScore)

// ============================================================================
//  LAYER 5 - MTF DIRECTIONAL LOCK (1D)          HARD VETO, NOT WEIGHTED
// ============================================================================
//  All three sub-conditions must agree for the bias to lock:
//    a) ADX(14) > 25            - is there a trend at all (non-directional)
//    b) close vs SMA(50)        - which side of the mean
//    c) EMA fast > med > slow   - stacking order confirms the same side
//  Any disagreement, or ADX below threshold, or na during warm-up -> 0
//  (neutral) and the system produces no signal. Neutral is the SAFE default:
//  a newly listed ticker without 200 daily bars yields no signals rather
//  than false ones. Lower the 1D EMA slow length for short-history names.
// ============================================================================
f_biasFrom(float adxv, float adxThreshold, float px, float sma, float ef, float em, float es) =>
    int b = 0
    if na(adxv) or na(px) or na(sma) or na(ef) or na(em) or na(es)
        b := 0
    else if adxv <= adxThreshold
        b := 0
    else
        bool bullAll = px > sma and ef > em and em > es
        bool bearAll = px < sma and ef < em and em < es
        b := bullAll ? 1 : (bearAll ? -1 : 0)
    b

// Evaluated INSIDE the bias timeframe by request.security (call #1).
// `off` shifts the read one bias-bar back when biasConfirmedOnly is ON; the
// shift must happen here, in the daily context, not on the returned series.
// Real OHLC is used here deliberately - see MIXED-CANDLE POLICY. The daily
// lock is a coarse regime gate where HA smoothing adds lag without benefit,
// and keeping it on real candles avoids mixing candle types across a veto.
f_dailyBiasExpr(simple int off) =>
    [_dp, _dm, _adxRaw] = ta.dmi(dAdxLen, dAdxSmooth)
    float _adx = _adxRaw[off]
    float _px  = close[off]
    float _sma = ta.sma(close, dSmaLen)[off]
    float _ef  = ta.ema(close, dEmaFastLen)[off]
    float _em  = ta.ema(close, dEmaMedLen)[off]
    float _es  = ta.ema(close, dEmaSlowLen)[off]
    int _bias = f_biasFrom(_adx, dAdxThr, _px, _sma, _ef, _em, _es)
    int _smaSide = na(_px) or na(_sma) ? 0 : (_px > _sma ? 1 : -1)
    int _emaSide = na(_ef) or na(_em) or na(_es) ? 0 :
     ((_ef > _em and _em > _es) ? 1 : ((_ef < _em and _em < _es) ? -1 : 0))
    [_bias, _adx, _smaSide, _emaSide]

[dBiasRaw, dAdxVal, dSmaSide, dEmaSide] = request.security(syminfo.tickerid, biasTF,
     f_dailyBiasExpr(biasConfirmedOnly ? 1 : 0),
     gaps = barmerge.gaps_off, lookahead = barmerge.lookahead_off)

// nz guard: before the first bias bar resolves the tuple is na -> neutral.
dBias = nz(dBiasRaw, 0)

// ---------------------------------------------------------------- The veto ---
// Score is zeroed BEFORE display, per spec - not merely hidden downstream.
biasLocked = dBias != 0
vetoPassed = not useVeto or (biasLocked and sigDir != 0 and sigDir == dBias)
totalScore = vetoPassed ? rawScore : 0.0
finalDir   = vetoPassed ? sigDir   : 0

// ============================================================================
//  PLOTS  (minimal, plot()/hline() only - no plotshape, no colour
//          coding of signals; that arrives in Stage 7)
// ============================================================================
plot(totalScore, "Total Score", color = color.new(color.gray, 0), linewidth = 2)
plot(showRawScore   ? rawScore   : na, "Raw Score (pre-veto)", color = color.new(color.gray, 60))
plot(showComponents ? longScore  : na, "Long Score",  color = color.new(color.teal,   35))
plot(showComponents ? shortScore : na, "Short Score", color = color.new(color.maroon, 35))
plot(showBias ? (dBias + 1) * 50 : na, "1D Bias", color = color.new(color.orange, 40),
     style = plot.style_stepline)

hline(scoreThreshold, "Threshold", color = color.new(color.gray, 40), linestyle = hline.style_dashed)
hline(80, "Band 80", color = color.new(color.gray, 80), linestyle = hline.style_dotted)
hline(60, "Band 60", color = color.new(color.gray, 80), linestyle = hline.style_dotted)
hline(40, "Band 40", color = color.new(color.gray, 80), linestyle = hline.style_dotted)
hline(0,  "Zero",    color = color.new(color.gray, 70))
